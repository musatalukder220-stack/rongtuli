<?xml version="1.0" encoding="utf-8"?>
<!-- Android 15 (API 35) puts every app edge to edge. The page already keeps clear of the system bars
     with env(safe-area-inset-*), which is only filled when the window says it draws edge to edge. -->
<resources>
    <style name="App" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
        <item name="android:colorAccent">#c04bf2</item>
    </style>
</resources>
